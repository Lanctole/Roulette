@inject IJSRuntime JS
@inject UserChoiceHistoryService UserChoiceHistoryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<IdentityUser> UserManager
@inject ImageCacheService ImageCacheService
@using Roulette.Models
@using Roulette.Services
@using ShikimoriSharp.Bases
@using Roulette.DTOs
@typeparam T

@if (MediaItems != null && MediaItems.Any())
{
    object? selectedMediaItem = MediaItems
        .FirstOrDefault(mediaItem =>
            (mediaItem is SmallRepresentation smallRep && smallRep.Id == SelectedID) ||
            (mediaItem is GameDto gameDto && gameDto.AppID == SelectedID));

    if (selectedMediaItem != null)
    {
        <MediaComponent Item="selectedMediaItem" ImageCache="@_imageCache"/>
    }
}

@code {

    [Parameter]
    public List<T>? MediaItems { get; set; }

    [Parameter]
    public bool IsWinner { get; set; }

    [Parameter]
    public MediaType MediaType { get; set; }

    private Dictionary<string, string> _imageCache = new();
    private HashSet<T> _processedItems = new();

    private DotNetObjectReference<MediaList<T>>? dotNetObjectRef;
    private long SelectedID { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (MediaItems != null)
        {
            foreach (var item in MediaItems)
            {
                if (_processedItems.Contains(item))
                    continue;

                _processedItems.Add(item);
                await PreloadImageAsync(item);
            }
        }
    }

    private async Task PreloadImageAsync(T item)
    {
        var imageUrl = item switch
        {
            SmallRepresentation smallRep => smallRep.Image.Original,
            GameDto gameDto => gameDto.HeaderImage,
            _ => null
            };

        if (!string.IsNullOrEmpty(imageUrl))
        {
            var cachedImage = await ImageCacheService.GetImageFromCacheAsync(imageUrl);
            _imageCache[imageUrl] = cachedImage ?? imageUrl;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        MediaItems ??= new List<T>();
        dotNetObjectRef = DotNetObjectReference.Create(this);
        JS.InvokeVoidAsync("registerDotNetObject", dotNetObjectRef);
    }

    private string GetImageUrl(string imageUrl)
    {
        return _imageCache.TryGetValue(imageUrl, out var cachedUrl) ? cachedUrl : "/path-to-default-image.jpg";
    }

    [JSInvokable]
    public async Task<string> ChangeID(int input)
    {
        if (IsWinner)
        {
            IsWinner = false;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name;

            if (userName != null)
            {
                var user = await UserManager.FindByNameAsync(userName);
                var userId = user?.Id;

                switch (MediaType)
                {
                    case MediaType.Anime:
                        await UserChoiceHistoryService.AddAnimeToHistoryAsync(userId, input);
                        break;
                    case MediaType.Manga:
                        await UserChoiceHistoryService.AddMangaToHistoryAsync(userId, input);
                        break;
                    case MediaType.Game:
                        await UserChoiceHistoryService.AddGameToHistoryAsync(userId, input);
                        break;
                }
            }
        }
        SelectedID = input;
        StateHasChanged();
        return await Task.FromResult(input.ToString());
    }

    public void Dispose()
    {
        dotNetObjectRef?.Dispose();
    }
}